{
  "expo": {
    "name": "TrackIt",
    "slug": "trackit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "trackit",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070707"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trackit.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "TrackIt needs access to save workout summary images.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070707"
      },
      "package": "com.trackit.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#070707",
      "themeColor": "#FF4F2E"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-image",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF4F2E",
          "defaultChannel": "rest"
        }
      ]
    ]
  }
}
